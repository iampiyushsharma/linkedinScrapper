# ── LinkedIn session (backend default) ───────────────────
# From a logged-in browser: DevTools → Application → Cookies → linkedin.com.
# Callers can also override this per request (see README).
LINKEDIN_LI_AT="your_li_at_cookie_here"
LINKEDIN_JSESSIONID=            # optional; auto-generated if blank

# ── Tuning (all optional) ────────────────────────────────
RATE_LIMIT_DEFAULT="10/minute"  # per-IP limit on /profile
PROFILE_CACHE_TTL="3600"        # seconds to cache a parsed profile
LINKEDIN_TIMEOUT="15"           # per-request timeout, seconds
