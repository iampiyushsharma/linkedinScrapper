# Environment variables for LinkedIn API Scraper

# Authentication Secrets (Do not commit real values)
# The `li_at` cookie value from a logged-in LinkedIn session
LINKEDIN_LI_AT="your_li_at_cookie_here"
# The `JSESSIONID` cookie value from a logged-in LinkedIn session
LINKEDIN_JSESSIONID="your_jsessionid_cookie_here"

# Optional: Default rate limit (Format: <count>/<duration> e.g. 10/minute, 5/second)
RATE_LIMIT_DEFAULT="10/minute"

# Optional: TTL for the profile cache in seconds
PROFILE_CACHE_TTL="3600"
